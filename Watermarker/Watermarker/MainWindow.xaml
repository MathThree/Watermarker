<Window x:Class="Watermarker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Watermarker"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid Background="#FF2B2B2B">
        <Button Content="Watermark n°1" HorizontalAlignment="Left" Margin="141,350,0,0" VerticalAlignment="Top" Click="Button_Click_Watermark1"/>
        <TextBox x:Name="WatermarkTextBox" HorizontalAlignment="Left" Margin="45,375,0,0" TextWrapping="Wrap" Text="Watermark" VerticalAlignment="Top" Width="120"/>
        <Button Content="Open image file" HorizontalAlignment="Left" Margin="45,350,0,0" VerticalAlignment="Top" Click="Button_Click_Open_File"/>
        <Image x:Name="TargetImage" HorizontalAlignment="Left" Height="200" Margin="45,71,0,0" VerticalAlignment="Top" Width="200" OpacityMask="White"/>
        <Image x:Name="WatermarkedImage" HorizontalAlignment="Right" Height="200" Margin="0,71,45,0" VerticalAlignment="Top" Width="200" OpacityMask="White"/>
        <Slider x:Name="AlphaSlider" HorizontalAlignment="Left" Margin="183,375,0,0" VerticalAlignment="Top" Width="120" Maximum="100" Value="50" ValueChanged="AlphaSlider_ValueChanged"/>
        <Button Content="Watermark n°2" HorizontalAlignment="Left" Margin="232,350,0,0" VerticalAlignment="Top" Click="Button_Click_Watermark2"/>
        <TextBlock x:Name="AlphaValueTextBlock" HorizontalAlignment="Left" Margin="303,376,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Foreground="White" Height="17" Text="0,5"/>

    </Grid>
</Window>
